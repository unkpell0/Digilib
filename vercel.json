{
  "version": 2,
  "builds": [
    { "src": "public/index.php", "use": "vercel-php@0.7.3" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "public/build" } }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/$1" },
    { "src": "/(img|logo|favicon.ico|robots.txt)(.*)", "dest": "/public/$1$2" },
    { "src": "/(.*)", "dest": "public/index.php" }
  ]
}